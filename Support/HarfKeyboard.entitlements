<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared by the app and the keyboard. SideStore replaces HARFTEAMID with the team of the
	     installing Apple ID, so settings and learned words live in "<team>.com.fezo.harf.shared". -->
	<key>keychain-access-groups</key>
	<array>
		<string>HARFTEAMID.com.fezo.harf.shared</string>
	</array>
</dict>
</plist>
