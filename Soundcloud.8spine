const API = 'https://api-v2.soundcloud.com';
const HEADERS = {
    'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/123.0.0.0 Safari/537.36',
    'Accept': 'application/json'
};
let clientId = null;

function qs(params) {
    return Object.keys(params)
        .filter(function (k) { return params[k] !== undefined && params[k] !== null; })
        .map(function (k) { return encodeURIComponent(k) + '=' + encodeURIComponent(params[k]); })
        .join('&');
}

async function fetchClientId() {
    const html = await (await fetch('https://soundcloud.com', { headers: HEADERS })).text();
    const scripts = (html.match(/https:\/\/a-v2\.sndcdn\.com\/assets\/[^"]+\.js/g) || []).reverse();
    for (const src of scripts) {
        const js = await (await fetch(src, { headers: HEADERS })).text();
        const m = js.match(/client_id\s*[:=]\s*"([a-zA-Z0-9]{32})"/);
        if (m) return m[1];
    }
    throw new Error('client_id not found');
}

async function scGet(path, params, retried) {
    if (!clientId) clientId = await fetchClientId();
    const url = API + path + '?' + qs(Object.assign({}, params || {}, { client_id: clientId }));
    const res = await fetch(url, { headers: HEADERS });
    if ((res.status === 401 || res.status === 403) && !retried) {
        clientId = null;
        return scGet(path, params, true);
    }
    if (!res.ok) throw new Error('SoundCloud HTTP ' + res.status);
    return res.json();
}

function debugResult(msg) {
    return [{ id: 'debug', title: 'DEBUG: ' + msg, artist: 'soundcloud-module', duration: 0, artwork: null, streamUrl: null }];
}

const SoundCloudModule = {
    id: "soundcloud",
    name: "SoundCloud",
    version: "1.0.2",
    author: "fouadalobaidi-bit",
    description: "البحث وتشغيل الموسيقى من SoundCloud.",
    baseUrl: "https://soundcloud.com",
    type: "MUSIC",
    sources: [{ id: "soundcloud", name: "SoundCloud", lang: "all", baseUrl: "https://soundcloud.com" }],

    search: async function (query, limit, offset) {
        try {
            const q = typeof query === 'string' ? query : JSON.stringify(query);
            const lim = Number(limit) > 0 ? Number(limit) : 10;
            const off = Number(offset) >= 0 ? Number(offset) : 0;
            const data = await scGet('/search/tracks', { q: q, limit: lim, offset: off, linked_partitioning: 1 });
            const items = data.collection || [];
            const out = items
                .filter(function (t) { return t.streamable !== false && t.policy !== 'BLOCK' && t.policy !== 'SNIP'; })
                .map(function (t) {
                    const art = t.artwork_url || (t.user && t.user.avatar_url) || '';
                    return {
                        id: String(t.id),
                        title: t.title,
                        artist: t.user ? t.user.username : 'Unknown Artist',
                        duration: t.duration ? t.duration / 1000 : 0,
                        artwork: art ? art.replace('-large', '-t500x500') : null,
                        streamUrl: null
                    };
                });
            if (!out.length) {
                return debugResult('raw=' + items.length + ' q=' + q + ' args=' + typeof query + ',' + typeof limit + ',' + typeof offset);
            }
            return out;
        } catch (e) {
            return debugResult(String((e && e.message) || e));
        }
    },

    getStreamUrl: async function (trackId) {
        try {
            const track = await scGet('/tracks/' + trackId);
            const tc = (track.media && track.media.transcodings) || [];
            const pick =
                tc.find(function (t) { return t.format && t.format.protocol === 'progressive'; }) ||
                tc.find(function (t) { return t.format && t.format.protocol === 'hls' && (t.format.mime_type || '').indexOf('audio/mpeg') === 0; });
            if (!pick) return null;

            const url = pick.url + '?' + qs({
                client_id: clientId,
                track_authorization: track.track_authorization
            });
            const res = await fetch(url, { headers: HEADERS });
            if (!res.ok) throw new Error('SoundCloud HTTP ' + res.status);
            return (await res.json()).url;
        } catch (e) {
            console.error("[SoundCloud] Stream error:", e);
            return null;
        }
    }
};

return SoundCloudModule;
